# ============================================================
# Susong Livewire - 环境配置模板
# 本地速送服务平台（含生鲜配送）
#
# 使用 UTF-8 编码（无BOM），中文注释在 Git/PHP/Laravel 下安全
# 复制为 .env 后，按注释提示填写必填项
# ============================================================

# ============================================================
# 应用基础（必填）
# ============================================================
# APP_NAME              应用名称（显示在浏览器标题、邮件等处）
# APP_ENV               运行环境：local / testing / production
# APP_KEY               加密密钥，执行 php artisan key:generate 生成
# APP_DEBUG             调试模式，生产环境必须设为 false
# APP_URL               应用地址（不带尾部斜杠）
APP_NAME="Susong"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://livewire.test

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# 维护模式驱动：file / database
APP_MAINTENANCE_DRIVER=file

# Bcrypt 加密轮数（越大越安全但越慢）
BCRYPT_ROUNDS=12

# ============================================================
# 数据库（必填）
# ============================================================
# DB_CONNECTION   驱动：mysql
# DB_HOST         主机地址
# DB_PORT         端口（默认 3306）
# DB_DATABASE     数据库名
# DB_USERNAME     用户名
# DB_PASSWORD     密码
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=livewire
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# 会话配置
# ============================================================
# SESSION_DRIVER     驱动：file / database / redis
# SESSION_LIFETIME   有效时长（分钟），120 = 2小时
# SESSION_ENCRYPT    是否加密会话数据
# SESSION_PATH       Cookie 路径
# SESSION_DOMAIN     Cookie 域名（null = 自动）
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE  是否仅通过 HTTPS 传输 Session Cookie
#   true  = 仅 HTTPS（生产环境必须设为 true）
#   false = HTTP 也可传输（本地开发环境 livewire.test 使用 HTTP，必须设为 false，否则 Cookie 不会被浏览器接受，Session 失效无法登录）
SESSION_SECURE_COOKIE=false

# ============================================================
# 缓存与队列
# ============================================================
# CACHE_STORE       缓存驱动：file / database / redis
# QUEUE_CONNECTION   队列驱动：sync / database / redis
CACHE_STORE=file
QUEUE_CONNECTION=database

# ============================================================
# Redis（当缓存/会话/队列使用 redis 时配置）
# ============================================================
# REDIS_CLIENT    客户端：phpredis / predis
# REDIS_HOST      主机地址
# REDIS_PASSWORD  密码（null = 无密码）
# REDIS_PORT      端口（默认 6379）
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# 广播 / WebSocket（Laravel Reverb）
# ============================================================
# BROADCAST_CONNECTION  广播驱动，本项目固定 reverb
# REVERB_APP_ID        Reverb 应用ID（首次部署时生成，不可为空）
# REVERB_APP_KEY       Reverb Key（暴露给前端，用于 WebSocket 握手）
# REVERB_APP_SECRET    Reverb Secret（仅服务端使用，切勿泄露）
# REVERB_HOST          WebSocket 主机（本地=localhost，生产=实际域名）
# REVERB_PORT          WebSocket 端口（本地=8080，生产=443）
# REVERB_SCHEME        协议：http（本地）/ https（生产）
#
# ⚠️ 凭证变量不要在此预写空行（如 REVERB_APP_ID=），
#    否则 reverb:install 检测到变量已存在会跳过，不会自动生成。
#    正确流程：复制 .env → 填写 DB → 执行 php artisan reverb:install
#    install 会自动追加凭证到 .env 末尾
BROADCAST_CONNECTION=reverb

# ============================================================
# 文件存储
# ============================================================
# FILESYSTEM_DISK  驱动：local / public / s3
FILESYSTEM_DISK=local

# ============================================================
# 邮件（开发环境用 log 驱动，不发送真实邮件）
# ============================================================
# MAIL_MAILER        驱动：log / smtp / sendmail
# MAIL_HOST          SMTP 主机
# MAIL_PORT          SMTP 端口
# MAIL_USERNAME      SMTP 用户名
# MAIL_PASSWORD      SMTP 密码
# MAIL_FROM_ADDRESS  发件人邮箱
# MAIL_FROM_NAME     发件人名称（自动读取 APP_NAME）
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# 微信小程序（按需填写）
# ============================================================
# WECHAT_MINI_APPID      商家端小程序 AppID
# WECHAT_MINI_SECRET     商家端小程序 Secret
# WECHAT_DRIVER_APPID    司机端小程序 AppID
# WECHAT_DRIVER_SECRET   司机端小程序 Secret
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_DRIVER_APPID=
WECHAT_DRIVER_SECRET=

# ============================================================
# 界面与其他
# ============================================================
# UI_SIZE  界面尺寸档位：S / M / L（默认 M）
UI_SIZE=M

# Vite 前端应用名称（自动读取 APP_NAME）
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# 日志
# ============================================================
# LOG_CHANNEL  驱动：stack / daily / single / slack
# LOG_LEVEL    级别：debug / info / notice / warning / error / critical
# LOG_DAYS     日志保留天数
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAYS=30
