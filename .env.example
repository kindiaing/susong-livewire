APP_NAME=Susong
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://susong.test

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAYS=30

# ============================
# 鏁版嵁搴?# ============================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=susong
DB_USERNAME=root
DB_PASSWORD=

# ============================
# 浼氳瘽锛堢鐞嗗悗鍙?Session 瀛?Redis锛?# ============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================
# 缂撳瓨 / 闃熷垪锛圧edis 椹卞姩锛?# ============================
CACHE_STORE=file
QUEUE_CONNECTION=database

# ============================
# Redis
# ============================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================
# 骞挎挱 / WebSocket锛圠aravel Reverb锛?# ============================
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=susong
REVERB_APP_KEY=app-susong-key
REVERB_APP_SECRET=app-susong-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
#REVERB_OPTIONS={"tls":{}}

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================
# 鏂囦欢瀛樺偍
# ============================
FILESYSTEM_DISK=local

# ============================
# 閭欢锛堝紑鍙戠幆澧冪敤 log锛?# ============================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================
# 寰俊灏忕▼搴?# ============================
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_DRIVER_APPID=
WECHAT_DRIVER_SECRET=

# ============================
# UI 灏哄妗ｄ綅锛圫/M/L锛岄粯璁?M锛?# ============================
UI_SIZE=M

VITE_APP_NAME="${APP_NAME}"

