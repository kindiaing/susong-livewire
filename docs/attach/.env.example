# ============================================================
# 本地速送服务平台（含生鲜配送）— 环境配置模板
# 复制本文件为 .env 后修改对应值
# ============================================================

# ----------------------
# 应用基础
# ----------------------
APP_NAME=Susong
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Shanghai

# ----------------------
# 数据库
# ----------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=susong
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ----------------------
# Redis
# ----------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ----------------------
# 文件存储
# ----------------------
# 驱动：local / oss / s3
FILESYSTEM_DRIVER=local

# 阿里云 OSS（FILESYSTEM_DRIVER=oss 时配置）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_CDN=

# ----------------------
# 队列与定时任务
# ----------------------
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=90
SCHEDULER_ENABLED=true

# ----------------------
# 微信小程序
# ----------------------
# 商家端
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# 司机端
WECHAT_DRIVER_APPID=
WECHAT_DRIVER_SECRET=

# ----------------------
# 跨域与前端
# ----------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# ----------------------
# 日志与审计
# ----------------------
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAYS=30
AUDIT_RETENTION_DAYS=365

# ----------------------
# 会话
# ----------------------
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
