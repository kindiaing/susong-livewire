# ============================================================
# Susong Livewire - 环境配置模板
# 本地速送服务平台（含生鲜配送）
#
# 用法：复制本文件为 .env  =>  cp docs/attach/.env.example .env
#       然后修改对应值并执行：php artisan key:generate
#
# 使用 UTF-8 编码（无BOM），中文注释在 Git/PHP/Laravel 下安全
# 如编辑器显示乱码，请将编码切换为 UTF-8
# ============================================================

# ============================================================
# 应用基础
# ============================================================
# APP_NAME              应用名称（显示在浏览器标题、邮件等处）
# APP_ENV               运行环境：local / testing / production
# APP_KEY               加密密钥，执行 php artisan key:generate 生成
# APP_DEBUG             调试模式，生产环境必须设为 false
# APP_URL               应用地址（不带尾部斜杠）
# APP_PORT              开发服务器端口（可选，artisan serve 用）
# APP_LOCALE            默认语言：zh_CN
# APP_FALLBACK_LOCALE   回退语言（zh_CN 缺失时使用）
# APP_FAKER_LOCALE      测试数据语言（Factory/Seeder 用）
APP_NAME="Susong"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# 维护模式驱动：file / database
APP_MAINTENANCE_DRIVER=file

# Bcrypt 加密轮数（越大越安全但越慢）
BCRYPT_ROUNDS=12

# 时区（可选，默认 UTC；中国区建议 Asia/Shanghai）
# TIMEZONE=Asia/Shanghai

# ============================================================
# 数据库（MySQL 8.0+）
# ============================================================
# DB_CONNECTION   驱动：mysql（项目默认）
# DB_HOST         主机地址
# DB_PORT         端口（默认 3306）
# DB_DATABASE     数据库名
# DB_USERNAME     用户名
# DB_PASSWORD     密码
# DB_CHARSET      字符集（推荐 utf8mb4）
# DB_COLLATION    排序规则（推荐 utf8mb4_unicode_ci）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=susong
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================================
# 会话配置
# ============================================================
# SESSION_DRIVER     驱动：file / database / redis（开发用 file，生产用 redis）
# SESSION_LIFETIME   有效时长（分钟），120 = 2小时
# SESSION_ENCRYPT    是否加密会话数据
# SESSION_PATH       Cookie 路径
# SESSION_DOMAIN     Cookie 域名（null = 自动）
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================
# 缓存与队列
# ============================================================
# CACHE_STORE       缓存驱动：file / database / redis（开发用 file，生产用 redis）
# QUEUE_CONNECTION   队列驱动：sync / database / redis（开发用 database，生产用 redis）
CACHE_STORE=file
QUEUE_CONNECTION=database

# ============================================================
# Redis（当缓存/会话/队列使用 redis 时配置）
# ============================================================
# REDIS_CLIENT      客户端：phpredis / predis
# REDIS_HOST        主机地址
# REDIS_PASSWORD    密码（null = 无密码）
# REDIS_PORT        端口（默认 6379）
# REDIS_DB          默认数据库索引（0）
# REDIS_CACHE_DB    缓存数据库索引（1）
# REDIS_QUEUE_DB    队列数据库索引（2）
# REDIS_SESSION_DB  会话数据库索引（3）
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ============================================================
# 广播 / WebSocket（Laravel Reverb）
# ============================================================
# BROADCAST_CONNECTION  广播驱动，本项目固定 reverb
# REVERB_APP_ID        Reverb 应用ID
# REVERB_APP_KEY       Reverb Key（通过 Vite 暴露给前端）
# REVERB_APP_SECRET    Reverb Secret（仅服务端使用，切勿泄露）
# REVERB_HOST          WebSocket 主机
# REVERB_PORT          WebSocket 端口
# REVERB_SCHEME        协议：http / https
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite 前端 Reverb 配置（自动读取上方变量）
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================
# 文件存储
# ============================================================
# FILESYSTEM_DISK  驱动：local / public / s3
FILESYSTEM_DISK=local

# 阿里云 OSS（可选，当 FILESYSTEM_DISK=oss 时配置）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=
# OSS_CDN=

# ============================================================
# 邮件
# ============================================================
# MAIL_MAILER        驱动：log（开发）/ smtp（生产）/ sendmail
# MAIL_HOST          SMTP 主机
# MAIL_PORT          SMTP 端口
# MAIL_USERNAME      SMTP 用户名
# MAIL_PASSWORD      SMTP 密码
# MAIL_FROM_ADDRESS  发件人邮箱
# MAIL_FROM_NAME     发件人名称（自动读取 APP_NAME）
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# 微信小程序
# ============================================================
# WECHAT_MINI_APPID      商家端小程序 AppID
# WECHAT_MINI_SECRET     商家端小程序 Secret
# WECHAT_DRIVER_APPID    司机端小程序 AppID
# WECHAT_DRIVER_SECRET   司机端小程序 Secret
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_DRIVER_APPID=
WECHAT_DRIVER_SECRET=

# ============================================================
# 跨域与前端（前后端分离时配置）
# ============================================================
# FRONTEND_URL             前端地址
# CORS_ALLOWED_ORIGINS     CORS 允许的来源
# SANCTUM_STATEFUL_DOMAINS Sanctum 有状态域名
# SESSION_DOMAIN           Cookie 域名（SPA 认证用）
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SANCTUM_STATEFUL_DOMAINS=localhost:3000
# SESSION_DOMAIN=localhost

# ============================================================
# 界面与其他
# ============================================================
# UI_SIZE  界面尺寸档位：S / M / L（默认 M）
UI_SIZE=M

# Vite 前端应用名称（自动读取 APP_NAME）
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# 日志
# ============================================================
# LOG_CHANNEL  驱动：stack / daily / single / slack
# LOG_LEVEL    级别：debug / info / notice / warning / error / critical
# LOG_DAYS     日志保留天数
# AUDIT_RETENTION_DAYS  审计日志保留天数（生产建议 365）
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAYS=30
AUDIT_RETENTION_DAYS=365
