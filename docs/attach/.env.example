# ============================================================
# Susong Livewire - 环境配置模板
# 本地速送服务平台（含生鲜配送）
#
# 用法：复制本文件为 .env  =>  cp docs/attach/.env.example .env
#       然后修改对应值并执行：php artisan key:generate
#
# 使用 UTF-8 编码（无BOM），中文注释在 Git/PHP/Laravel 下安全
# 如编辑器显示乱码，请将编码切换为 UTF-8
#
# 标注说明：
#   [必填] 项目运行必须配置
#   [可选] 有默认值或不影响核心功能，按需配置
# ============================================================

# ============================================================
# 应用基础
# ============================================================
# APP_NAME              [必填] 应用名称（显示在浏览器标题、邮件等处）
# APP_ENV               [必填] 运行环境：local / testing / production
# APP_KEY               [必填] 加密密钥，执行 php artisan key:generate 生成
# APP_DEBUG             [必填] 调试模式，生产环境必须设为 false
# APP_URL               [必填] 应用地址（不带尾部斜杠）
# APP_PORT              [可选] 开发服务器端口（artisan serve 用，默认 8000）
# APP_LOCALE            [可选] 默认语言（默认 zh_CN）
# APP_FALLBACK_LOCALE   [可选] 回退语言（zh_CN 缺失时使用，默认 en）
# APP_FAKER_LOCALE      [可选] 测试数据语言（Factory/Seeder 用，默认 zh_CN）
APP_NAME="Susong"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# APP_MAINTENANCE_DRIVER  [可选] 维护模式驱动：file / database（默认 file）
APP_MAINTENANCE_DRIVER=file

# BCRYPT_ROUNDS           [可选] Bcrypt 加密轮数（越大越安全但越慢，默认 10）
BCRYPT_ROUNDS=12

# TIMEZONE               [可选] 时区（默认 UTC；中国区建议 Asia/Shanghai）
# TIMEZONE=Asia/Shanghai

# ============================================================
# 数据库（MySQL 8.0+）
# ============================================================
# DB_CONNECTION   [必填] 驱动：mysql（项目默认）
# DB_HOST         [必填] 主机地址
# DB_PORT         [必填] 端口（默认 3306）
# DB_DATABASE     [必填] 数据库名
# DB_USERNAME     [必填] 用户名
# DB_PASSWORD     [必填] 密码（本地开发可留空）
# DB_CHARSET      [可选] 字符集（推荐 utf8mb4）
# DB_COLLATION    [可选] 排序规则（推荐 utf8mb4_unicode_ci）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=susong
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================================
# 会话配置
# ============================================================
# SESSION_DRIVER        [必填] 驱动：file / database / redis（开发用 file，生产用 redis）
# SESSION_LIFETIME      [可选] 有效时长（分钟），120 = 2小时
# SESSION_ENCRYPT       [可选] 是否加密会话数据（默认 false）
# SESSION_PATH          [可选] Cookie 路径（默认 /）
# SESSION_DOMAIN        [可选] Cookie 域名（null = 自动）
# SESSION_SECURE_COOKIE [必填] 是否仅通过 HTTPS 传输 Session Cookie
#   true  = 仅 HTTPS（生产环境必须设为 true）
#   false = HTTP 也可传输（本地开发环境如 livewire.test 使用 HTTP，必须设为 false，
#           否则 Cookie 不会被浏览器接受，Session 失效无法登录）
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ============================================================
# 缓存与队列
# ============================================================
# CACHE_STORE         [可选] 缓存驱动：file / database / redis（开发用 file，生产用 redis）
# QUEUE_CONNECTION    [可选] 队列驱动：sync / database / redis（开发用 database，生产用 redis）
CACHE_STORE=file
QUEUE_CONNECTION=database

# ============================================================
# Redis（当缓存/会话/队列使用 redis 时配置）
# ============================================================
# REDIS_CLIENT        [可选] 客户端：phpredis / predis（默认 phpredis）
# REDIS_HOST          [可选] 主机地址（默认 127.0.0.1）
# REDIS_PASSWORD      [可选] 密码（null = 无密码）
# REDIS_PORT          [可选] 端口（默认 6379）
# REDIS_DB            [可选] 默认数据库索引（0）
# REDIS_CACHE_DB      [可选] 缓存数据库索引（1）
# REDIS_QUEUE_DB      [可选] 队列数据库索引（2）
# REDIS_SESSION_DB    [可选] 会话数据库索引（3）
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ============================================================
# 广播 / WebSocket — Pusher（当前使用）
# ============================================================
# BROADCAST_CONNECTION  [必填] 广播驱动：pusher / reverb / null
# PUSHER_APP_ID         [必填] Pusher 应用ID（在 Pusher Dashboard 创建应用后获取）
# PUSHER_APP_KEY        [必填] Pusher Key（会暴露给前端，用于 WebSocket 连接认证）
# PUSHER_APP_SECRET     [必填] Pusher Secret（仅服务端使用，切勿泄露给前端）
# PUSHER_APP_CLUSTER    [必填] Pusher 集群（ap1 = 新加坡，mt1 = 美东，eu = 欧洲）
# PUSHER_HOST           [可选] 自定义 Pusher API 主机（留空则自动按 cluster 拼接）
# PUSHER_PORT           [可选] 端口（默认 443）
# PUSHER_SCHEME         [可选] 协议：https / http（默认 https）
#
# VITE_PUSHER_APP_KEY    [必填] Vite 前端读取的 Pusher Key（自动读取上方变量）
# VITE_PUSHER_APP_CLUSTER [必填] Vite 前端读取的 Pusher 集群（自动读取上方变量）
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# Vite 前端 Pusher 配置（自动读取上方变量）
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# 广播 / WebSocket — Laravel Reverb（备选方案，当前未启用）
# ============================================================
# 如需从 Pusher 切换到 Reverb（自建 WebSocket 服务器），操作步骤：
#   1. 将 BROADCAST_CONNECTION 改为 reverb
#   2. 填写下方 Reverb 凭据
#   3. 前端 resources/js/app.js 中将 Echo 配置从 pusher 改为 reverb
#      （参考 docs/handbook/11b_Reverb_实时推送开发教程.md）
#   4. 注释上方 Pusher 的 VITE_PUSHER_* 变量，取消下方 VITE_REVERB_* 注释
#   5. 执行 php artisan config:clear && npm run build
#
# REVERB_APP_ID        [必填*] Reverb 应用ID（*切换到 reverb 时必填）
# REVERB_APP_KEY       [必填*] Reverb Key（通过 Vite 暴露给前端）
# REVERB_APP_SECRET    [必填*] Reverb Secret（仅服务端使用，切勿泄露）
# REVERB_HOST          [可选] WebSocket 主机（默认 localhost，生产用域名）
# REVERB_PORT          [可选] WebSocket 端口（默认 8080）
# REVERB_SCHEME        [可选] 协议：http / https（默认 http，生产用 https）
#
# VITE_REVERB_APP_KEY   [必填*] Vite 前端读取的 Reverb Key
# VITE_REVERB_HOST      [可选] Vite 前端读取的 Reverb 主机
# VITE_REVERB_PORT      [可选] Vite 前端读取的 Reverb 端口
# VITE_REVERB_SCHEME    [可选] Vite 前端读取的 Reverb 协议
# BROADCAST_CONNECTION=reverb

# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# Vite 前端 Reverb 配置（自动读取上方变量）
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================
# 文件存储
# ============================================================
# FILESYSTEM_DISK  [可选] 驱动：local / public / s3（默认 local）
FILESYSTEM_DISK=local

# 阿里云 OSS（可选，当 FILESYSTEM_DISK=oss 时配置）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=
# OSS_CDN=

# ============================================================
# 邮件
# ============================================================
# MAIL_MAILER        [可选] 驱动：log（开发）/ smtp（生产）/ sendmail（默认 log）
# MAIL_SCHEME       [可选] 加密方式：tls / null（默认 null）
# MAIL_HOST          [可选] SMTP 主机
# MAIL_PORT          [可选] SMTP 端口
# MAIL_USERNAME      [可选] SMTP 用户名
# MAIL_PASSWORD      [可选] SMTP 密码
# MAIL_FROM_ADDRESS  [可选] 发件人邮箱
# MAIL_FROM_NAME     [可选] 发件人名称（自动读取 APP_NAME）
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# 微信小程序
# ============================================================
# WECHAT_MINI_APPID      [可选] 商家端小程序 AppID（对接商家端小程序时必填）
# WECHAT_MINI_SECRET     [可选] 商家端小程序 Secret（对接商家端小程序时必填）
# WECHAT_DRIVER_APPID    [可选] 司机端小程序 AppID（对接司机端小程序时必填）
# WECHAT_DRIVER_SECRET   [可选] 司机端小程序 Secret（对接司机端小程序时必填）
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_DRIVER_APPID=
WECHAT_DRIVER_SECRET=

# ============================================================
# 跨域与前端（前后端分离时配置）
# ============================================================
# FRONTEND_URL             [可选] 前端地址
# CORS_ALLOWED_ORIGINS     [可选] CORS 允许的来源
# SANCTUM_STATEFUL_DOMAINS [可选] Sanctum 有状态域名
# SESSION_DOMAIN           [可选] Cookie 域名（SPA 认证用，覆盖上方同名配置）
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SANCTUM_STATEFUL_DOMAINS=localhost:3000
# SESSION_DOMAIN=localhost

# ============================================================
# 界面与其他
# ============================================================
# UI_SIZE  [可选] 界面尺寸档位：S / M / L（默认 M）
UI_SIZE=M

# VITE_APP_NAME  [必填] Vite 前端应用名称（自动读取 APP_NAME）
VITE_APP_NAME="${APP_NAME}"

# ============================================================
# 日志
# ============================================================
# LOG_CHANNEL             [可选] 驱动：stack / daily / single / slack（默认 stack）
# LOG_DEPRECATIONS_CHANNEL [可选] 弃用警告日志通道（默认 null）
# LOG_LEVEL               [可选] 级别：debug / info / notice / warning / error / critical（默认 debug）
# LOG_DAYS                [可选] 日志保留天数（daily 驱动用，默认 7）
# AUDIT_RETENTION_DAYS    [可选] 审计日志保留天数（生产建议 365）
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAYS=30
AUDIT_RETENTION_DAYS=365
